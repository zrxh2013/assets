# ============================================================
# 支付宝沙箱配置模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入沙箱凭证（从 https://open.alipay.com/develop/sandbox/app 拿）
#   3. 重启服务：python app.py
#   4. 验证：python -c "from alipay_client import is_real_pay; print(is_real_pay())" 应输出 True
#
# 沙箱环境说明：
#   - 沙箱资金不流动，可放心测试
#   - 沙箱版支付宝 App 下载：https://open.alipay.com/develop/sandbox/app
#   - 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ============================================================

# 支付模式：simulation=模拟支付（默认），real=真实支付宝
ALIPAY_MODE=real

# 沙箱/生产环境：sandbox=沙箱，production=生产
ALIPAY_ENV=sandbox

# 沙箱应用 APPID（在沙箱应用页面"基础信息"里找，形如 2021001xxxxxxxxx）
ALIPAY_APP_ID=请替换为你的沙箱APPID

# 应用私钥（RSA2）：在"接口加签方式"里选"公钥模式"后下载的应用私钥
# 注意：是应用私钥，不是支付宝公钥；不要带 -----BEGIN/END----- 头尾，纯 base64 串即可
# 长度通常 1600-1700 字符，不含换行
ALIPAY_APP_PRIVATE_KEY=请替换为你的应用私钥

# 支付宝公钥：在"接口加签方式"里设置应用公钥后，支付宝回传的"支付宝公钥"
# 长度通常 392 字符左右，纯 base64 串
ALIPAY_PUBLIC_KEY=请替换为支付宝公钥

# 签名算法：固定 RSA2（推荐）
ALIPAY_SIGN_TYPE=RSA2

# 异步通知 URL（支付宝服务器主动 POST 到这里）：
#   - 必须公网可达，支付宝服务器要能访问到
#   - 用 tunnel.sh 拿到公网域名后填：
#       bash tunnel.sh
#       # 等输出公网 URL 后填到下面
ALIPAY_NOTIFY_URL=http://your-public-domain/alipay/notify

# 同步回跳 URL（买家支付后浏览器跳回）：
#   - 买家浏览器可达即可，可填公网或本地
ALIPAY_RETURN_URL=http://127.0.0.1:8000/pay/return

# Flask Session 密钥（不填则自动生成并持久化到 .secret_key 文件）
# 生产环境务必固定一个：python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=
