# ===== 测试网部署所需（Polygon Amoy + Tron Nile）=====

# Polygon Amoy 部署者私钥（需持有测试 MATIC）
# 注意：只放测试网私钥，切勿填主网私钥
PRIVATE_KEY=your_amoy_private_key_here

# Tron Nile 部署者私钥（hex 格式，需持有测试 TRX）
TRON_PRIVATE_KEY=your_nile_private_key_here

# Polygon Amoy RPC（默认 https://polygon-amoy.drpc.org）
AMOY_RPC=https://polygon-amoy.drpc.org

# 每次跨链的数量，单位 tMOCK（默认 100）
# BRIDGE_AMOUNT=100

# ===== 主网部署所需（可选，默认不启用）=====
# 私钥（Polygon 主网）
# PRIVATE_KEY_MAINNET=your_polygon_private_key_here

# 源代币地址（Polygon 上的自定义 ERC-20）
# SOURCE_TOKEN=0xYourTokenAddress

# Polygon 主网 RPC
# POLYGON_RPC=https://polygon-rpc.com
